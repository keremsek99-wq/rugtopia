# Signs the Unity-exported Xcode project and uploads it to TestFlight.
# Auth is an App Store Connect API key. Certificates live in a PRIVATE match repo.
# The owner has no Mac: the first run (MATCH_READONLY unset) creates the Apple
# Distribution certificate on this runner and pushes it to that private repo.

default_platform(:ios)

platform :ios do
  desc "Sign the Unity iOS project and upload to TestFlight"
  lane :beta do
    bundle_id = ENV.fetch("IOS_BUNDLE_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    repo_root = File.expand_path("..", __dir__)

    setup_ci
    # setup_ci forces MATCH_READONLY=true. There is no Mac to create the cert
    # ahead of time, so the first CI run must be allowed to create it.
    requested = ENV.fetch("MATCH_READONLY_REQUESTED", "false").strip.downcase
    want_readonly = %w[true 1 yes].include?(requested)
    ENV["MATCH_READONLY"] = want_readonly ? "true" : "false"

    match(
      type: "appstore",
      readonly: want_readonly,
      app_identifier: bundle_id,
      team_id: team_id,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      api_key: asc_api_key
    )

    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"]
    UI.user_error!("match did not export sigh_#{bundle_id}_appstore_profile-name") if profile_name.to_s.empty?

    project_path = Dir[File.join(repo_root, "build", "**", "Unity-iPhone.xcodeproj")].first
    UI.user_error!("Unity-iPhone.xcodeproj not found under build/") if project_path.nil?
    UI.message("Signing #{project_path}")

    apply_manual_signing(project_path, bundle_id, team_id, profile_name)

    ios_root = File.dirname(project_path)
    workspace = nil
    if File.exist?(File.join(ios_root, "Podfile"))
      sh("gem install cocoapods --no-document") unless system("which pod > /dev/null 2>&1")
      Dir.chdir(ios_root) { sh("pod install") }
      workspace = Dir[File.join(ios_root, "*.xcworkspace")].reject { |w| w.include?("project.xcworkspace") }.first
    end

    ipa_dir = File.join(repo_root, "build", "ipa")
    build_args = {
      scheme: "Unity-iPhone",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: ipa_dir,
      output_name: "Rugtopia.ipa",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { bundle_id => profile_name }
      }
    }
    if workspace
      build_app(**build_args, workspace: workspace)
    else
      build_app(**build_args, project: project_path)
    end

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: File.join(ipa_dir, "Rugtopia.ipa"),
      skip_waiting_for_build_processing: true
    )
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APPSTORE_KEY_ID"),
    issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
    key_content: ENV.fetch("APPSTORE_P8"),
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

def apply_manual_signing(project_path, bundle_id, team_id, profile_name)
  require "xcodeproj"
  project = Xcodeproj::Project.open(project_path)
  project.targets.each do |target|
    target.build_configurations.each do |config|
      settings = config.build_settings
      settings["CODE_SIGN_STYLE"] = "Manual"
      settings["DEVELOPMENT_TEAM"] = team_id
      settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
      settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = "Apple Distribution"
      if target.name == "Unity-iPhone"
        settings["PRODUCT_BUNDLE_IDENTIFIER"] = bundle_id
        settings["PROVISIONING_PROFILE_SPECIFIER"] = profile_name
      else
        settings["PROVISIONING_PROFILE_SPECIFIER"] = ""
        settings.delete("PROVISIONING_PROFILE")
      end
    end
  end
  project.save
end
